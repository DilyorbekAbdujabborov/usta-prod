{
  "info": {
    "name": "Ustalar API",
    "description": "Ustalar.uz — usta xizmatlari platformasi API. Auth: HttpOnly cookie (access_token + refresh_token)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "opencode"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://ustalar-sand.vercel.app", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('accessToken', pm.cookies.get('access_token'));",
                  "  pm.collectionVariables.set('refreshToken', pm.cookies.get('refresh_token'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"998901234567\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login" }
          },
          "response": [
            {
              "name": "200 OK",
              "body": "{\n  \"id\": \"uuid\",\n  \"phone\": \"998901234567\",\n  \"name\": \"Admin\",\n  \"role\": \"client\",\n  \"isAdmin\": true,\n  \"balance\": \"0 UZS\",\n  \"completedJobs\": 0,\n  \"isBlocked\": false,\n  \"createdAt\": \"2025-01-01T00:00:00.000Z\"\n}"
            },
            {
              "name": "401 Unauthorized",
              "body": "{\n  \"error\": \"Telefon raqami yoki parol noto'g'ri\"\n}"
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"phone\": \"998901234567\",\n  \"password\": \"parol12345\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register" }
          },
          "response": [
            {
              "name": "201 Created",
              "body": "{\n  \"id\": \"uuid\",\n  \"phone\": \"998901234567\",\n  \"name\": \"Test User\",\n  \"role\": \"client\",\n  \"isAdmin\": false,\n  \"balance\": \"0 UZS\",\n  \"completedJobs\": 0,\n  \"isBlocked\": false,\n  \"createdAt\": \"2025-01-01T00:00:00.000Z\"\n}"
            },
            {
              "name": "409 Conflict",
              "body": "{\n  \"error\": \"Bu telefon raqami allaqachon ro'yxatdan o'tgan\"\n}"
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/logout" }
          },
          "response": [{ "name": "204 No Content", "body": "" }]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/refresh" }
          },
          "response": [
            { "name": "200 OK", "body": "{ \"ok\": true }" },
            { "name": "401 Unauthorized", "body": "{ \"error\": \"Unauthorized\" }" }
          ]
        },
        {
          "name": "Reset Request (SMS kod)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"998901234567\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/reset-request" }
          },
          "response": [{ "name": "200 OK", "body": "{ \"ok\": true }" }]
        },
        {
          "name": "Reset Verify (kod bilan)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"998901234567\",\n  \"code\": \"123456\",\n  \"newPassword\": \"yangiParol123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/reset-verify" }
          },
          "response": [
            { "name": "200 OK", "body": "{ \"id\": \"uuid\", \"phone\": \"998901234567\", \"name\": \"Test\", \"role\": \"client\" }" },
            { "name": "400 Bad Request", "body": "{ \"error\": \"Kod noto'g'ri yoki muddati o'tgan\" }" }
          ]
        }
      ]
    },
