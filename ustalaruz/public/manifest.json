{
	"name": "Usta - Professional Ustalar",
	"short_name": "Usta",
	"description": "O'zbekistondagi eng yaxshi usta va mutaxassislarni topish platformasi",
	"id": "/",
	"start_url": "/",
	"display": "standalone",
	"display_override": ["window-controls-overlay", "tabbed", "standalone", "fullscreen"],
	"background_color": "#0F172A",
	"theme_color": "#1D4ED8",
	"orientation": "portrait",
	"scope": "/",
	"scope_extensions": [
		{ "origin": "ustaback.pythonanywhere.com" }
