# Backend API URL
# Update this to your deployed Django backend URL
VITE_API_BASE_URL=https://mastergroup.uz

# App version is no longer a manual env var - the client build embeds the
# git short SHA automatically (see vite.config.ts, __APP_VERSION__).

# VAPID public key is now fetched from the backend at
# GET /api/push/public-key/ (see core.settings.VAPID_PUBLIC_KEY on the
# backend) — no frontend env var needed anymore.